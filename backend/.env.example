PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

DATABASE_URL=
DATABASE_SSL=
DATABASE_SSL_CA=
RATE_LIMIT_SECRET=
SESSION_COOKIE_SAME_SITE=lax
PAYMENT_SIMULATION_ENABLED=false

DB_HOST=localhost
DB_PORT=5432
DB_NAME=konserkita_db
DB_USER=postgres
DB_PASSWORD=

# Local development only. Never commit backend/.env or put secrets in VITE_* variables.
# Development DATABASE_URL is allowed only for localhost:5432/konserkita_db with the configured postgres role.
# Leave DATABASE_URL empty to use DB_*; development refuses remote, alternate, or disposable targets.
# Production may use DATABASE_URL and keeps verified TLS.
# DATABASE_SSL=false is allowed only for a local development database.
# Remote databases use verified TLS by default. DATABASE_SSL_CA accepts a trusted PEM CA.
# SESSION_COOKIE_SAME_SITE defaults to lax. Use none only in production with an HTTPS FRONTEND_URL.
# Do not disable certificate verification in production or for remote databases.
# Set RATE_LIMIT_SECRET to a random value of at least 32 bytes in production.
# Payment simulation is opt-in only for NODE_ENV=development; production always disables it.
